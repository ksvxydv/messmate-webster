# ============================================================
# MessMate Production Environment Configuration
# ============================================================

# 1. Supabase PostgreSQL & Realtime Configuration
# Replace with your production Supabase project details.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# 2. Institutional Security & Email Verification
# Restricts student and staff registration/login to verified college domains.
NEXT_PUBLIC_COLLEGE_DOMAIN=mnnit.ac.in

# 3. Server-side Cryptographic HMAC Secret
# REQUIRED in production. Used for:
# - Signing rotating TOTP-style QR tokens (HMAC-SHA256)
# - Generating and verifying cryptographic session tokens
# DO NOT expose this to client code. Must be at least 32 bytes (64 hex characters).
# Generate using: openssl rand -hex 32
HMAC_SECRET=replace_with_a_random_64_character_hex_secret

# 4. Demo & Presentation Mode (CRITICAL SECURITY SETTING)
# Set to "false" (or leave unset) in production to disable:
# - Development role switchers in Navbar, Login, and Auth cards
# - Mock time-travel and clock simulation
# - Admin dev seeding & CAS stress testing suites
# - Automated demo persona auto-filling
NEXT_PUBLIC_ENABLE_DEMO_CONTROLS=false

# 5. Node Environment
NODE_ENV=production
