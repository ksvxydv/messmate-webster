# ============================================================
# MessMate Environment Configuration
# ============================================================

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Institutional email domain
NEXT_PUBLIC_COLLEGE_DOMAIN=mnnit.ac.in

# Server-only HMAC secret for rotating QR signatures
# Generate a unique value using: openssl rand -hex 32
HMAC_SECRET=replace_with_a_random_64_character_hex_secret